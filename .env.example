# Copy to .env and fill in. Never commit .env.

# Models
# Keep this key here only. Do not set it as a system environment variable,
# or Claude Code will bill it instead of your Max plan.
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-haiku-5-5
MODEL_COMPARE=claude-sonnet-5-5

# Spend guards. The CLI and the benchmark harness refuse to run without them.
# Replace these with measured numbers after the phase 1 pilot.
MAX_USD_PER_RUN=0.25
MAX_USD_PER_BATCH=5.00
MAX_ATTEMPTS=3
MAX_PROMPT_TOKENS=90000

# dbt project the agent works on
DBT_PROJECT_DIR=demo/jaffle_shop
DBT_PROFILES_DIR=demo/jaffle_shop
DUCKDB_PATH=demo/jaffle_shop/warehouse.duckdb

# GitHub. Only needed to open pull requests outside GitHub Actions.
GITHUB_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
